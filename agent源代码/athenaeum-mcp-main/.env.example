# ── Athenaeum configuration (all optional) ──────────────────────────────────
# Copy to ".env" and fill in. NOTHING here is required for the core providers
# (OpenAlex, Crossref, arXiv, Europe PMC, PubMed, DBLP, OpenCitations,
# bioRxiv/medRxiv, DOAJ) — they are 100% free, no key.
#
# Step-by-step guides for every provider that needs setup live in
# docs/providers/ (each one is actively maintained).

# Your email. Strongly recommended: it puts requests in the "polite pool" of
# OpenAlex and Crossref (faster, more reliable) and is REQUIRED to enable the
# optional Unpaywall provider. Use a real address you control.
ATHENAEUM_EMAIL=

# Optional Semantic Scholar API key. Without it, Semantic Scholar is heavily
# rate-limited (HTTP 429) and is treated as best-effort only.
# Guide: docs/providers/semantic-scholar.md
# Request a free key: https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# Optional NCBI (PubMed) API key. PubMed works WITHOUT a key; a key only raises
# the rate limit from 3 to 10 requests/second.
# Guide: docs/providers/pubmed.md  —  Create a key: https://account.ncbi.nlm.nih.gov/
NCBI_API_KEY=

# CORE API key. REQUIRED to enable the CORE full-text provider (it is inactive
# without one). Everything else works regardless.
# Guide: docs/providers/core.md  —  Request a key: https://core.ac.uk/services/api
CORE_API_KEY=

# Optional OpenCitations access token. OpenCitations works WITHOUT a token; a
# token only raises rate limits.
# Guide: docs/providers/opencitations.md  —  https://opencitations.net/accesstoken
OPENCITATIONS_ACCESS_TOKEN=

# Optional: enable Unpaywall OA-PDF discovery. Requires ATHENAEUM_EMAIL set to
# a REAL email (Unpaywall rejects placeholder addresses with HTTP 422).
# Guide: docs/providers/unpaywall.md
ATHENAEUM_ENABLE_UNPAYWALL=false

# ── Zotero integration (optional) ───────────────────────────────────────────
# Lets the athenaeum_zotero_add tool push references into your Zotero library.
# Guide: docs/providers/zotero.md
# Create a key at https://www.zotero.org/settings/keys (enable "write" access).
# Your library ID is the number shown there (for a personal/user library).
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
# "user" for a personal library (default) or "group" for a group library.
ZOTERO_LIBRARY_TYPE=user

# ── Tuning (optional) ───────────────────────────────────────────────────────
# On-disk HTTP cache TTL in seconds (default 86400 = 24h). Set 0 to disable.
ATHENAEUM_CACHE_TTL=86400

# Per-request network timeout in seconds (default 30).
ATHENAEUM_TIMEOUT=30
